{
    "name": "template-bare",
    "version": "1.2.1",
    "scripts": {
        "dev": "vite --config vite.config.cjs --mode development",
        "dev:open": "vite --config vite.config.cjs --mode development --open",
        "build": "vite build --config vite.config.cjs --mode production",
        "build-zip": "npm run build && bare-engine-zip",
        "dev-nolog": "vite --config vite.config.cjs --mode development --open",
        "build-nolog": "vite build --config vite.config.cjs --mode production",
        "analyze": "bare-engine-analyze",
        "poki-upload": "poki upload",
        "build:assets": "node node_modules/bare-engine/scripts/buildAssets.cjs",
        "update-engine": "npm install bare-engine@github:bare-engine/bare-engine#semver:^0.6.0"
    },
    "author": "Jeroen Wimmers",
    "license": "MIT",
    "devDependencies": {
        "typescript": "6.0.3",
        "vite": "^6.3.5"
    },
    "dependencies": {
        "bare-engine": "github:bare-engine/bare-engine#semver:^0.6.0"
    },
    "bareEngine": {
        "firstLevelLoad": "level_1",
        "texturePackImages": {
            "stripUnused": true,
            "alwaysInclude": [
                "tile_0098",
                "ring",
                "circle"
            ]
        },
        "index": {
            "title": "Bare RPG",
            "backgroundColor": "rgb(255, 255, 255)",
            "textColor": "rgb(0, 0, 0)"
        },
        "gameId": "bareRPG"
    },
    "allowScripts": {
        "esbuild": true,
        "sharp": true,
        "vue-demi": true
    }
}
