{
    "name": "template-bare",
    "version": "1.2.1",
    "scripts": {
        "dev": "vite --config vite.config.cjs --mode development",
        "dev:open": "vite --config vite.config.cjs --mode development --open",
        "build": "vite build --config vite.config.cjs --mode production",
        "build-zip": "npm run build && cd dist && bestzip ../dist.zip *",
        "dev-nolog": "vite --config vite.config.cjs --mode development --open",
        "build-nolog": "vite build --config vite.config.cjs --mode production",
        "analyze": "bare-engine-analyze",
        "poki-upload": "poki upload",
        "build:assets": "node node_modules/bare-engine/scripts/buildAssets.cjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/BareEngine/Template.git"
    },
    "author": "Jeroen Wimmers",
    "license": "MIT",
    "devDependencies": {
        "@assetpack/core": "^1.7.0",
        "bestzip": "^2.2.1",
        "typescript": "5.9.3",
        "vite": "^6.3.5"
    },
    "dependencies": {
        "bare-engine": "file:../BareEngine"
    },
    "bareEngine": {
        "firstLevelLoad": "level1",
        "stripTexturePackImages": true,
        "texturePackImagesToInclude": ["tile_0098", "stripeParticle", "ring", "circle"],
        "index": {
            "title": "Bare RPG",
            "backgroundColor": "rgb(255, 255, 255)",
            "textColor": "rgb(0, 0, 0)",
            "showLoading": false
        }
    }
}
